{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--no-sandbox",
        "--executable-path",
        "/opt/pw-browsers/chromium"
      ],
      "env": {}
    },
    "dropshot": {
      "type": "http",
      "url": "https://mcp.aistudio.dropshot.io/mcp"
    }
  }
}